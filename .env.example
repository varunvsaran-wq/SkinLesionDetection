# Copy to .env and fill in. NEVER commit the real .env.
# All values are optional for Phase 0/1 (the mocked graph runs without them).

# --- Claude / Anthropic (Phase 4+) ---
ANTHROPIC_API_KEY=
# Override the interpretation model if needed (default: claude-opus-4-8).
# CLAUDE_MODEL=claude-opus-4-8

# --- State persistence ---
# LangGraph checkpointer DB. SQLite for dev; swap to a Postgres URL for prod.
DATABASE_URL=sqlite:///checkpoints/dermassist.sqlite

# --- Dataset (Phase 2+) ---
# Local path to HAM10000 / ISIC images. Images are git-ignored — do not commit them.
DATASET_PATH=data/ham10000

# --- Vision classifier (Phase 3) ---
# CLASSIFIER_MODEL=Anwarkh1/Skin_Cancer-Image_Classification

# --- Literature retrieval (Phase 5+) ---
# PubMed MCP server endpoint (Streamable HTTP). Unset → mock references.
# Run the bundled server: uv run python tools/pubmed_mcp_server.py
MCP_ENDPOINT=
MCP_PUBMED_TOOL=search_pubmed
# EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
# Have Claude author per-reference relevance notes (one extra API call):
# LITERATURE_CLAUDE_CITATIONS=false

# --- App ---
# Environment label: dev | prod
APP_ENV=dev
